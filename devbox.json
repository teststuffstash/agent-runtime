{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "github:NixOS/nixpkgs/619c39f6eac5d1ed6b8f073a9414baf7034b2356#python315Packages.pytest",
    "gh@latest",
    "gitleaks@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "ci": [
        "bash scripts/ci.sh"
      ],
      "pr-gate": [
        "bash scripts/ci.sh && devbox run scan-secrets"
      ],
      "test": [
        "pytest tests/ -q"
      ],
      "scan-secrets": [
        "gitleaks detect --source . --no-banner --verbose"
      ]
    }
  }
}
