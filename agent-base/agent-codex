#!/usr/bin/env bash
# agent-codex — the headless Codex invocation seam (agent-runtime#146, slice 2 of the Codex
# subscription-rail spike).
#
# The launcher owns the COMMAND (`codex exec --json <prompt>`); this seam owns the CONTRACT around
# it, so every Codex ride looks the same to the rest of the platform:
#
#   • run in the prepared $WORKDIR — never the caller's cwd (the repo is cloned there);
#   • invoke `codex exec --json` so the transcript is JSONL, one event per line;
#   • tee stdout+stderr into $RUN_LOG (default /tmp/run.log) — the file agent-finalize reads for
#     classify()/parse_outcome();
#   • exit with Codex's OWN status, unchanged (a nonzero Codex must not be masked by tee).
#
# Config is USER-LEVEL and runtime-supplied: Codex reads $CODEX_HOME/config.toml (default
# ~/.codex). The image bakes NO auth.json — a custom `model_providers.<id>` with command-backed
# bearer auth (`auth.command`/`args`/`cwd`/`timeout_ms`/`refresh_interval_ms`) is the launcher's
# config, not the image's. This seam points Codex at that home and, for a GATEWAY ride (the three
# dispatch env vars below), renders the provider block from the env VALUES; it never writes a
# credential — the session token is read by the CLI through `env_key`.
set -uo pipefail

WORKDIR="${WORKDIR:-/work/repo}"
RUN_LOG="${RUN_LOG:-/tmp/run.log}"
CODEX_BIN="${CODEX_BIN:-codex}"
# Honor a launcher-supplied CODEX_HOME; default to Codex's own ~/.codex. Exported so the child
# process resolves the same user-level config the launcher mounted.
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export CODEX_HOME

cd "$WORKDIR" || exit 1
mkdir -p "$(dirname "$RUN_LOG")"

# The GATEWAY cell (homelab FU-270 — GW-SESSIONS-ENV's codex rows): a /sessions ride pulls exactly
# OPENAI_BASE_URL, OPENAI_API_KEY and CODEX_MODEL into the env before this seam runs. The pinned CLI
# reads its provider from CONFIG, not from env (observed with codex-cli 0.161.0: a bare
# OPENAI_BASE_URL is ignored), so this seam renders the provider block from those VALUES: the base
# url and the model are written, the token NEVER is — the CLI reads it through `env_key`. No such
# env = no render: a mounted config.toml (the auth.command shape above) stands untouched.
# The stack's MCP knob (homelab #1041, `spec.mcp.endpoint`) rides the same render: the launcher's
# codex arm exports CODEX_MCP_URL and this seam appends the pinned CLI's remote-server shape —
# `[mcp_servers.<name>] url = "…"` (codex-rs `config/src/mcp_types.rs` StreamableHttp; no bearer,
# no headers: the endpoint is unauthenticated inside the cluster, as for the other three harnesses).
# No CODEX_MCP_URL = no block; no gateway render = no block either (a mounted config stands).
if [ -n "${OPENAI_BASE_URL:-}" ] && [ -n "${CODEX_MODEL:-}" ]; then
  for v in "$OPENAI_BASE_URL" "$CODEX_MODEL" "${CODEX_MCP_URL:-}"; do
    case "$v" in *[\"\\$'\n'$'\r']*) echo "agent-codex: refusing to render a provider block from a value with a quote, backslash or newline" >&2; exit 78;; esac
  done
  mkdir -p "$CODEX_HOME"
  ( umask 077; cat > "$CODEX_HOME/config.toml" <<TOML
model = "${CODEX_MODEL}"
model_provider = "agent-gateway"
cli_auth_credentials_store = "file"
[model_providers.agent-gateway]
name = "agent-gateway"
base_url = "${OPENAI_BASE_URL}"
wire_api = "responses"
env_key = "OPENAI_API_KEY"
requires_openai_auth = false
supports_websockets = false
request_max_retries = 0
stream_max_retries = 0
TOML
    if [ -n "${CODEX_MCP_URL:-}" ]; then
      cat >> "$CODEX_HOME/config.toml" <<TOML
[mcp_servers.stack-mcp]
url = "${CODEX_MCP_URL}"
TOML
    fi
  )
  echo "→ agent-codex: provider block rendered into \$CODEX_HOME/config.toml (base_url=${OPENAI_BASE_URL}, model=${CODEX_MODEL}; the token stays in env${CODEX_MCP_URL:+; mcp_servers.stack-mcp=${CODEX_MCP_URL}})"
fi

# `exec --json` is the deterministic headless contract; the launcher supplies the prompt and any
# extra flags. PIPESTATUS[0] is Codex's status — tee's is deliberately ignored.
"$CODEX_BIN" exec --json "$@" 2>&1 | tee -a "$RUN_LOG"
exit "${PIPESTATUS[0]}"
