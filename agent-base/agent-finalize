#!/usr/bin/env python3
"""End-of-session stats + terminal bookkeeping for an agent run (homelab agent platform).

Two modes:
  agent-finalize --snapshot   # at entrypoint: record start time + OpenRouter usage baseline
  agent-finalize <run_log>    # after the harness: salvage-push, emit `AGENT_RUN_STATS {json}`,
                              # arm/comment/strike on GitHub, push metrics, upload transcripts

Cost is computed HERE because the pod (not the launcher) holds the OpenRouter key — usage delta over
the run = this run's $. GitHub bookkeeping (auto-merge arming, the stats PR comment, the AGENT_STRIKE
issue comment) ALSO lives here since 2026-07-09 (homelab FU-064/FU-043): the dispatcher's lifetime is
decoupled from the worker's (a coordinator pod exits ~1 min after dispatch), so anything owned by the
launcher's post-run block silently doesn't happen on that path — three strikes in one session were
posted by hand before this moved in-pod. The launcher keeps a FALLBACK copy of each step, skipped when
the stats line carries the corresponding `*_by_pod` flag. Requires issues:write on the worker token
(git-token.yaml files). Everything is best-effort: a stats/bookkeeping failure must never fail the run.

INTERPRETER (who owns the python this runs on): agent-base's OWN `python@3.11` — the
`/opt/agent/.devbox` profile baked into this image (agent-base/devbox.json), which sits on the
container PATH. This is deliberately NOT the cloned project's python: finalize runs AFTER the harness,
OUTSIDE any `devbox run`, so a stack that pins a different version in ITS devbox.json (e.g.
python@3.14) runs only its own code on 3.14 — this script is unaffected and always executes on 3.11.
Kept strictly to the stdlib (no third-party imports) so it tolerates a bump, but the version is a
PLATFORM choice owned HERE (bump it in agent-base/devbox.{json,lock}, never a project's), decoupled
from every stack. Corollary: a python-version bug that "breaks in one project but not another" can
only be in project code (its own `devbox run` python), never in this file.
"""
import json, os, re, shutil, subprocess, sys, time, urllib.parse, urllib.request

START_EPOCH = "/tmp/agent-start-epoch"
USAGE_START = "/tmp/agent-usage-start"
# One line per CLOSED in-pod phase, appended by `agent-finalize --mark` (FU-160 / #66). Written by
# the entrypoint for the spans that end BEFORE --snapshot; read once, at finalize.
PHASE_MARKS = "/tmp/agent-phase-marks"
PUSHGATEWAY_DEFAULT = "http://prometheus-pushgateway.monitoring.svc.cluster.local:9091"


def or_usage():
    """Cumulative USD usage for the current OpenRouter key. Returns None when UNKNOWN — a dead/
    expired key 401s this endpoint, and failing INTO 0.0 made exactly the runs that die on key
    problems report ~$0/negative cost (agent-runtime#12; the probe-fails-into-a-value class,
    homelab TICK-LOG rule #6). A 200 whose body omits `usage` says the same thing by a different
    route (#41). The caller must treat None as 'unknown', never as a number."""
    key = os.environ.get("OPENROUTER_API_KEY")
    if not key:
        return None
    # ADR-087: under credential injection the pod holds an opaque ref only the egress proxy can
    # resolve — so this read MUST ride the proxy (OPENROUTER_HOST) when it's set; direct-to-upstream
    # would 401 the ref and turn every injected run's cost into cost_unknown.
    base = os.environ.get("OPENROUTER_HOST") or "https://openrouter.ai"
    try:
        req = urllib.request.Request(
            base.rstrip("/") + "/api/v1/key",
            headers={"Authorization": "Bearer " + key},
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            usage = json.load(r)["data"].get("usage")
        # A 200 that carries no `usage` (absent key, or an explicit null) reported no figure — the
        # probe SUCCEEDED and still learned nothing, which is unknown, not zero (agent-runtime#41).
        # `or 0.0` flattened that into an authoritative $0 that subtracts against the banked
        # baseline exactly like the dead-key 401 did. A reported 0.0 is a fact and stays a number.
        if usage is None:
            return None
        return float(usage)
    except Exception:
        return None


def router_report(stats, exit_status, error_class):
    """homelab FU-095 P1: POST the run report to the egress proxy's /report (ADR-096 M5) from
    IN-POD — the launcher's finalizer twin. AGENT_REPORT_URL + AGENT_STACK are launcher-injected
    (stack resolution is launcher-owned; the pod has no homelab checkout). Best-effort: absent
    env or unreachable proxy skips loudly, never fails the run."""
    url = os.environ.get("AGENT_REPORT_URL") or ""
    if not url:
        return
    payload = {
        "session": os.environ.get("HOSTNAME") or stats.get("pod") or "",
        "task": os.environ.get("AGENT_TASK") or "",
        "stack": os.environ.get("AGENT_STACK") or "",
        "role": "worker",
        "round": int(os.environ.get("AGENT_ROUND") or 1),
        "model": os.environ.get("MODEL") or os.environ.get("GOOSE_MODEL") or stats.get("model") or "",
        # Which rail served the ride (agent-runtime#55). The launcher twin has sent this since
        # homelab#158 and `run_reports` grew the column in homelab#164 — but a coordinator-path
        # ride has no attending launcher (the reason this function exists in-pod, FU-095 P1), so
        # for precisely the fleet-wide degrade #158 was written about the store said rail="". The
        # value is launcher-injected into the pod env; report it, never derive it here.
        "rail": os.environ.get("AGENT_RAIL") or "",
        # Never fabricate a cost (agent-runtime#12). `float(stats.get("cost_usd") or 0.0)` posted an
        # authoritative-looking $0 for runs that HAVE no cost — the dead-key runs — which is the
        # undercount push_metrics already refuses to emit, and which the budget gate now charges
        # against. Unknown rides as null (+ the marker below); a genuine 0.0 stays a genuine 0.0,
        # a distinction `or 0.0` also flattened. Null keeps the POST safe for today's receiver.
        "cost_usd": None if stats.get("cost_usd") is None else float(stats["cost_usd"]),
        "error_class": error_class or "",
        "outcome": "pr" if stats.get("pr_url") else (exit_status or "no-pr"),
    }
    # Only an OpenRouter-priced run can be backfilled from the activity API, so only it gets the
    # flag — a subscription run has no key and no dollars, and is unknown in neither sense.
    if stats.get("cost_unknown"):
        payload["cost_unknown"] = True
    req = urllib.request.Request(url, data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=5) as r:
        print("router-report: posted (%s) -> %s" % (url, r.status), flush=True)


def cost_fields(usage_start, usage_end):
    """The usage delta → the stats' cost fields. Pure, so the #12 invariant is testable.

    Either end being None means the probe FAILED, not that it read zero — a dead key 401s
    `/api/v1/key`, and subtracting against a failed probe is what produced negative costs on
    exactly the key-death runs. Unknown is unknown: no number at all, `cost_unknown` instead, and
    the ledger-reflex prices the run later from the activity API (FU-057). The clamp covers a
    residual negative from usage accounting still settling — that is 0, never a discount.
    """
    if usage_start is None or usage_end is None:
        return {"cost_unknown": True}
    return {"cost_usd": max(0.0, round(usage_end - usage_start, 4))}


def _read_float(path):
    try:
        return float(open(path).read().strip())
    except Exception:
        return None


def claude_usage():
    """Tokens/turns for a claude-harness run — the FU-066(b) stand-in for cost_usd (subscription
    tier: ~$0 marginal, so the honest record is usage, not a fake dollar figure). Summed from the
    session jsonl under ~/.claude/projects — the pod is fresh per run, so everything there is this
    run's. `turns` counts assistant messages (≈ API calls, the same grain as goose's turn cap).
    Returns {} when no session file is found (e.g. claude died before writing one)."""
    base = os.path.expanduser("~/.claude/projects")
    tin = tout = cache_read = turns = 0
    found = False
    for root, _, names in os.walk(base):
        for name in names:
            if not name.endswith(".jsonl"):
                continue
            try:
                with open(os.path.join(root, name), errors="replace") as fh:
                    for line in fh:
                        try:
                            ev = json.loads(line)
                        except Exception:
                            continue
                        if not isinstance(ev, dict):
                            continue  # a non-dict line must not abort the rest of the file
                        usage = (ev.get("message") or {}).get("usage")
                        if ev.get("type") == "assistant" and usage:
                            found = True
                            turns += 1
                            tin += int(usage.get("input_tokens") or 0) \
                                + int(usage.get("cache_creation_input_tokens") or 0)
                            cache_read += int(usage.get("cache_read_input_tokens") or 0)
                            tout += int(usage.get("output_tokens") or 0)
            except Exception:
                continue
    if not found:
        return {}
    return {"turns": turns, "tokens_in": tin, "tokens_cache_read": cache_read, "tokens_out": tout}


def claude_cost_equiv(log_path):
    """Opportunistic API-equivalent cost: `claude -p --output-format json` ends the log with a
    result object carrying total_cost_usd. Absent (plain text output), returns None — tokens/turns
    above remain the record."""
    try:
        text = open(log_path, errors="replace").read()
    except Exception:
        return None
    val = None
    for m in re.finditer(r'"total_cost_usd"\s*:\s*([0-9.eE+-]+)', text):
        try:
            val = float(m.group(1))
        except ValueError:
            continue
    return val


def snapshot():
    open(START_EPOCH, "w").write(str(int(time.time())))
    usage = or_usage()
    open(USAGE_START, "w").write("" if usage is None else repr(usage))


def parse_outcome(log_path):
    """Pull the recipe's structured final_output JSON (last matching object) from the run log."""
    keys = ("reproduced", "ci_passed", "branch", "pr_url", "coverage_pct", "root_cause")
    found = {}
    try:
        text = open(log_path, errors="replace").read()
    except Exception:
        return found
    # The recipe emits a brace-free-inner JSON object with these keys; take the last well-formed one.
    for m in re.finditer(r'\{[^{}]*"(?:reproduced|pr_url|ci_passed)"[^{}]*\}', text):
        try:
            obj = json.loads(m.group(0))
            found = {k: obj[k] for k in keys if k in obj}
        except Exception:
            continue
    return found


def _log_text(log_path):
    if not log_path:
        return ""
    try:
        with open(log_path, errors="replace") as fh:
            return fh.read()
    except Exception:
        return ""


def _marker_path():
    """Where agent-storm-watchdog leaves its verdict, resolved EXACTLY as the watchdog resolves it:
    AGENT_WATCHDOG_MARKER (canonical), then the legacy STORM_MARKER, then the shipped default. The
    watchdog used to read only STORM_MARKER here, so overriding either name alone moved one side and
    the verdict landed in a file this never opened — silently, since the defaults agree (#46).
    `agent-storm-watchdog --marker` prints that side's answer for a test to pin against this one."""
    return (
        os.environ.get("AGENT_WATCHDOG_MARKER")
        or os.environ.get("STORM_MARKER")
        or "/tmp/agent-watchdog-class"
    )


def _watchdog_class():
    """The watchdog's verdict, when it killed this run (#13). It writes a marker BEFORE the SIGTERM
    because the signal alone is indistinguishable from any other kill — the run would land as
    nonzero-exit-143, which says "someone stopped it" and nothing about why. Read the file, not the
    exit code. Absent marker = the watchdog didn't fire; this stays out of the way entirely."""
    try:
        with open(_marker_path()) as fh:
            return fh.read().strip()[:40]
    except Exception:
        return ""


def failure_signature(text, ci_passed=None, watchdog=""):
    """The dominant machine-detectable failure in a run log → (exit_status, error_class), or None.

    Pure over the log text so the precedence is testable, and shared: `classify` and
    `salvage_push` must answer "did this round die?" the same way (#36) — two inlined chains that
    happen to agree today is how that bug got written in the first place.

    Precedence: a broken key dooms the whole run, so it outranks the truncation it usually ends on;
    ≥5 auth failures = a storm, not a transient token refresh.
    """
    def n(pat):
        return len(re.findall(pat, text, re.IGNORECASE | re.MULTILINE))

    # Line-precise signatures (measured against the first oracle-fleet runs, 2026-07-09).
    # git-auth is GIT/GH-specific (a dead ~1h App token at push/PR time), distinct from the LLM-key
    # auth storm: a run whose WORK is green but whose push 401s must classify no-artifact/token-expiry,
    # not auth-storm (oracle-fleet#1 attempt 1: 49 min of green work stranded by exactly this).
    gitauth = n(r"authentication failed for 'https://github|fatal: could not read username|"
                r"bad credentials|gh: .*http 401|failed to fetch oauth token")
    auth = n(r"authentication failed|401 unauthorized|403 forbidden|invalid api key|"
             r"no auth credentials|invalid_api_key")
    forbidden = n(r"403 forbidden")
    # OpenRouter budget cap / billing 402 — the retry-into-a-wall class. Precise phrasings only, so
    # legal/statute text containing "credit"/"quota" (2–3 stray hits/run) doesn't trip it.
    budget = n(r"insufficient (credit|quota|fund)|require[sd]? more credit|payment required|"
               r"402 payment|quota exceeded|budget exceeded|out of credit|key limit exceeded")
    truncation = n(r"-32602|response may have been truncated|maximum context length|"
                   r"context_length_exceeded")
    panic = n(r"thread '.*' panicked|panicked at|fatal runtime error")
    timeout = n(r"context deadline exceeded|operation timed out|request timed out|"
                r"timeout of \d+\s*ms exceeded")

    if budget:
        return "budget-403", "budget-exhausted"
    if gitauth and ci_passed is True:
        return "no-artifact", "token-expiry"  # green work, dead git token at push/PR time
    if auth >= 5:
        return "auth-storm", "http-403-storm" if forbidden >= auth - forbidden else "http-401-storm"
    if watchdog == "repetition-loop":
        # Below budget/auth on purpose: kimi-k3's repetition WAS its post-403 retry storm, and
        # "budget-exhausted" is the cause worth striking on — the repetition is that death's
        # symptom. When no key/billing signature is present, this is the real class.
        return "harness-death", "repetition-loop"
    if truncation:
        return "harness-death", "goose-32602-truncation"
    if panic:
        return "harness-death", "goose-panic"
    if timeout:
        return "timeout", "timeout"
    return None


def died_this_round(fail, stats):
    """"Did THIS ROUND die?" — the one predicate behind both of #36's surfaces.

    A `pr_url` proves an ARTIFACT EXISTS. It never proves THIS ROUND produced it: from round 2 on
    the URL is routinely the PREVIOUS round's PR, adopted by `derive_pr_url` from the branch (or,
    2026-08-07, from the branch the launcher's salvage pushed). Both call sites used to read the
    one as the other, so on a fix round — which by definition always has a PR — `classify`
    returned `clean` for a run that died and `salvage_push` banked nothing. circles#32 r3 is the
    measured case: the identical `-32602` truncation struck the model in r1 and read `clean` in r3.

    The tiebreak is the recipe's structured end-of-run report (`reproduced`/`ci_passed`/
    `root_cause`, lifted into stats by `parse_outcome`) — the same evidence the `blocked-deliberate`
    class already trusts. A round that emitted it reached its own finish line, so signature strings
    left in its log are text, not a death; a round that never emitted one did not finish, and its
    dominant signature stands whatever PR is lying around. That direction matters both ways: the
    silent-death half of #36 is the dangerous one, but flipping every log that merely CONTAINS
    "-32602" into a strike would fabricate deaths (this repo's own test suite writes those strings
    into every green run.log it produces).

    `no-artifact`/token-expiry is excluded on purpose: it is a claim about the ARTIFACT ("green
    work never reached GitHub"), which an existing PR contradicts. Only session deaths outrank it.
    """
    if not fail or fail[0] == "no-artifact":
        return False
    return not any(k in stats for k in ("reproduced", "ci_passed", "root_cause"))


# The exit_status values that mean THIS ROUND DIED: everything `failure_signature` can return, minus
# `no-artifact` — which `died_this_round` excludes for the reason above, and which an existing PR
# contradicts. `bookkeeping` reads these instead of re-deriving the predicate: by the time it runs,
# `classify` has already put `died_this_round`'s answer into `stats["exit_status"]`, and re-running
# the signature match over the log there would be a second place for the two to disagree.
DEATH_EXIT_STATUSES = ("harness-death", "auth-storm", "budget-403", "timeout")


def bookkeeping_route(stats):
    """Which terminal GitHub action this run gets: "arm" | "strike" | "deliberate-stop" (#49).

    The third surface of #36's predicate. `bookkeeping` used to ask only "is there a PR?", but a PR
    proves an ARTIFACT EXISTS — on a fix round from round 2 on it is routinely the PREVIOUS round's,
    so a round that DIED still armed auto-merge and posted a stats comment. `classify` was fixed to
    call that run `harness-death`; the strike comment it implies was still never posted, and that
    comment IS the store a coordinator greps to walk the model chain on re-dispatch. The strike went
    missing on exactly the rounds it exists for.

    So the split is three-way, not two — the artifact and the round's fate are separate questions:
      - PR, round did not die  → "arm"    (arm auto-merge + stats comment, unchanged)
      - PR, round died         → "strike" (no arm, no stats comment — but see below)
      - no PR                  → "strike", or "deliberate-stop" when the worker stopped on its own
                                 judgment (that is a decision, not a death — retro r1 F2)
    The #32 issue-link guarantee is NOT part of this answer: it hangs off the PR alone, because a
    died round's PR is a real artifact that the coordinator scan must still be able to link to its
    issue (an unlinked one reads as "worker terminal, no PR" and gets RE-DISPATCHED onto finished
    work). A died round needs that link more than a clean one, not less.
    """
    if stats.get("pr_url") and stats.get("exit_status") not in DEATH_EXIT_STATUSES:
        return "arm"
    if stats.get("exit_status") == "blocked-deliberate":
        return "deliberate-stop"
    return "strike"


def classify(log_path, stats):
    """Classify the run into (exit_status, error_class) — the FU-057 enabler.

    exit_status ∈ clean | ci-failed | no-artifact | harness-death | auth-storm | budget-403 | timeout | blocked-deliberate | failed
    error_class = the dominant machine-detectable cause ('' when clean). Derived from run.log
    patterns + the run's OUTCOME (did it open a PR / pass CI). This is what makes the model-blacklist
    call possible (docs/agents/observability-and-retro.md §B1): the ledger needs to know *why* a run
    ended, not just that it cost $X and took Ys.

    Why not trust HARNESS_EXIT: measured 2026-07-09, goose exits 0 even when it storms on auth or
    dies to a `-32602` truncation (worker-r3 issue-1: 530 auth failures, no PR, exit 0). So SUCCESS
    is judged by artifact (pr_url / ci_passed), and FAILURE by the dominant log pattern — the exit
    code is only a last-resort tiebreak. Patterns are line-precise (not bare "401", which matches
    digits inside filenames/ids — a successful run logged 21 such false hits).

    The artifact answers "did something ship", NOT "did this round end well" (#36): a death
    signature from a round that never reported its own end outranks it — see `died_this_round`.
    """
    try:
        harness_exit = int(str(os.environ.get("HARNESS_EXIT", "")).strip() or "0")
    except ValueError:
        harness_exit = 0
    text = _log_text(log_path)

    ci_passed = stats.get("ci_passed")
    # SUCCESS requires the ARTIFACT — a PR. ci_passed alone is NOT clean: a run whose work went
    # green in-pod but never reached GitHub (dead git token, unpushed branch) used to classify
    # `clean` and poison the model-health pivot with a success that shipped nothing (oracle-fleet#1
    # attempt 1). Those runs are `no-artifact` now.
    succeeded = bool(stats.get("pr_url"))
    fail = failure_signature(text, ci_passed, _watchdog_class())

    # #36: a DEATH outranks the artifact. `succeeded` used to short-circuit here, before `fail` was
    # consulted at all — and since a fix round always has a PR (that is what a fix round is), from
    # round 2 on NO failure signature could ever fire: not truncation, not panic, not auth-storm,
    # not budget. Every death on a fix round reported `clean`, so the model was never struck and
    # the router was told the run was fine (circles#32 r3, circles#58). Only the first round of an
    # issue could strike anything. `died_this_round` holds the line in both directions.
    if died_this_round(fail, stats):
        return fail
    if succeeded:
        if ci_passed is False:
            return "ci-failed", "ci-red"
        return "clean", ""
    if fail:
        return fail
    # Adhoc rides (task not issue-*/pr-*: validations, interactive experiments) expect NO PR —
    # "no artifact" is their normal clean end, not a failure. Without this, a PASSING validation
    # ride lands in the ledger as failed/no-output and poisons the model-health pivot (seen live
    # on the FU-066 acceptance ride, 2026-07-16). ci_passed guards the other direction: a recipe
    # that REPORTED failing tests must not read clean just because the harness exited 0 (#16 review).
    task = os.environ.get("AGENT_TASK") or ""
    if not (task.startswith("issue-") or task.startswith("pr-")) and harness_exit == 0 \
            and ci_passed is not False:
        return "clean", ""
    # Deliberate stop (retro r1 F2, oracle-fleet#66): the worker emitted its structured final
    # report (the contract JSON parsed — ci_passed/reproduced/root_cause present) and exited 0
    # with no PR and no failure signature. That is a DECISION, not a death: distinct class so
    # the strike/chain-walk machinery never re-runs it on the next model — the coordinator
    # judges the report instead (encodes what #66's coordinator did by hand).
    if harness_exit == 0 and any(k in stats for k in ("ci_passed", "reproduced", "root_cause")):
        return "blocked-deliberate", "worker-stop-report"
    if ci_passed is True:
        return "no-artifact", "no-pr"  # green in-pod, no PR, no detectable infra cause
    if harness_exit != 0:
        return "failed", "nonzero-exit-%d" % harness_exit
    return "failed", "no-output"  # goose exited 0 but produced no PR and left no detectable error


def _broker_git_token():
    """homelab FU-123: fetch the live worker token straight from the proxy's /git-token endpoint.
    FU-089 deleted the standing in-ns git Secret, so the mount below is empty on broker-era rides —
    without this fetch the whole gh section ran tokenless (5/5 un-armed PRs, #96/PR#107 the
    confirming case) while git pushes kept working through the credential helper. Mirrors the
    entrypoint's agent-git-token: the projected SA token rides as a Bearer (TokenReview'd
    broker-side; absent SA stays legal until GIT_TOKEN_REQUIRE_AUTH=1)."""
    url = os.environ.get("GIT_CRED_BROKER_URL", "")
    if not url:
        return ""
    headers = {}
    try:
        sa = open("/var/run/secrets/kubernetes.io/serviceaccount/token").read().strip()
        if sa:
            headers["Authorization"] = "Bearer " + sa
    except Exception:
        pass
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=10) as r:
            return r.read().decode().strip()
    except Exception as e:
        print("finalize: broker git-token fetch failed: %s (falling back to mount/env)" % e,
              file=sys.stderr)
        return ""


def _fresh_gh_env():
    """Env for git/gh subprocesses with the FRESHEST git token: broker → mounted Secret file →
    inherited env, the entrypoint's agent-git-token order. The file (rotated by ESO every
    refreshInterval) beats the env var, which is frozen at pod start — a >60-min run's env
    token is dead by the time finalize pushes (homelab FU-064b)."""
    env = dict(os.environ)
    tok = _broker_git_token()
    if not tok:
        path = os.environ.get("GIT_TOKEN_FILE", "/secrets/git/token")
        try:
            tok = open(path).read().strip()
        except Exception:
            tok = ""
    if tok:
        env["GH_TOKEN"] = tok
    return env


def _resolve_branch():
    """The shared work-branch resolution (salvage_push + derive_pr_url must not drift): returns
    (wd, base, branch) with branch=None when there's no usable work branch (no repo, detached
    HEAD, or still sitting on the base branch)."""
    wd = os.environ.get("WORKDIR", "/work/repo")
    base = os.environ.get("BASE_REF", "master")
    if not os.path.isdir(os.path.join(wd, ".git")):
        return wd, base, None
    try:
        branch = subprocess.run(["git", "-C", wd, "rev-parse", "--abbrev-ref", "HEAD"],
                                capture_output=True, text=True, timeout=30).stdout.strip()
    except Exception:
        branch = ""
    if not branch or branch in ("HEAD", base):
        return wd, base, None
    return wd, base, branch


def salvage_push(stats, log_path=""):
    """FU-064a: harness-owned terminal push. If the run ends without a PR but the work branch has
    commits (and/or uncommitted state), commit + push it — a died run must leave a RESUMABLE branch,
    never zero artifact. The push-early recipe rule failed to bind on 3 runs / 2 models (homelab
    TICK-LOG 2026-07-09): this is the mechanism that replaces the exhortation. Best-effort.
    MUST run before derive_pr_url: the pr_url guard below is about the recipe's SELF-report (PR
    opened this round → nothing to salvage); a derived pr_url can come from an OLDER still-open PR
    on a resumed branch, and skipping on that would silently drop this round's commits.

    #36: the self-report is not proof of success either. A fix round that echoes the PR it was sent
    to fix, then DIES, self-reports a pr_url while its working tree holds everything the round did
    — so the guard asks the run log the same question `classify` asks (`died_this_round`) and skips
    only for a round that reached its own end. The guard still has to exist: salvaging a genuinely
    finished round would `git add -A` whatever junk the tree holds and force-push a wip commit onto
    a PR already under review.

    Sets `salvaged_branch` when a push lands, and `salvage_undetermined` when the branch state
    could not be established (#33) — the strike comment must not turn "I could not tell" into
    "there is nothing to resume"."""
    if stats.get("pr_url") and not died_this_round(
            failure_signature(_log_text(log_path), stats.get("ci_passed"), _watchdog_class()),
            stats):
        return
    wd, base, branch = _resolve_branch()
    if branch is None:
        # No repo, detached HEAD, or still sitting on the base branch — none of which finalize can
        # tell apart from "the work is elsewhere". Unknown, not "nothing was committed" (#33).
        stats["salvage_undetermined"] = True
        return

    def git(*args, timeout=60):
        return subprocess.run(["git", "-C", wd, *args], capture_output=True, text=True,
                              timeout=timeout, env=_fresh_gh_env())

    try:
        if git("status", "--porcelain").stdout.strip():
            git("add", "-A")
            git("commit", "-m", "wip(salvage): uncommitted state at terminal [agent-finalize]")
        ahead = git("rev-list", "--count", "origin/%s..HEAD" % base).stdout.strip()
        if not ahead.isdigit():
            stats["salvage_undetermined"] = True  # rev-list failed: ahead-ness unknown, not zero
            return
        if int(ahead) == 0:
            return  # the honest "nothing was committed": on a work branch, zero commits ahead
        # --force-with-lease: the branch may exist remotely from a prior attempt of the same round.
        pushed = git("push", "--force-with-lease", "-u", "origin", branch, timeout=120)
        if pushed.returncode == 0:
            stats["salvaged_branch"] = branch
            print("salvage: pushed %s (%s commits ahead of %s)" % (branch, ahead, base), flush=True)
        else:
            stats["salvage_undetermined"] = True  # commits exist here; the remote's state is unknown
            print("salvage: push FAILED for %s: %s (non-fatal)"
                  % (branch, pushed.stderr.strip()[-300:]), file=sys.stderr)
    except Exception as e:
        stats["salvage_undetermined"] = True
        print("salvage: non-fatal error: %s" % e, file=sys.stderr)


def resumable_branch(stats, env=None):
    """"Is there anything to resume for THIS ISSUE?" — the question the coordinator is actually
    asking when it reads the strike comment (agent-runtime#33).

    Finalize used to answer the round-scoped question instead (`salvaged_branch`, set only when
    this round pushed). The two agree on round 1 and diverge on every resumed round that fails —
    circles#22 r2 resumed a branch holding the entire deliverable (1 commit, +1051), committed
    nothing new, and was reported as having no resumable branch, so the next dispatch would restart
    from base and discard it.

    Two in-pod sources, both already known — deliberately NOT a scan of remote `agent/*` branches,
    which is how the wrong branch gets resumed:

      1. `salvaged_branch` — this round pushed it, so it exists. Reported as "pushed": strongest
         and most recent, and it is the branch HEAD was actually on.
      2. `WORK_BRANCH` in the environment — the launcher set it iff the ride was dispatched with
         `--work-branch` (the entrypoint's own fallback name is a plain shell var, never exported),
         so a value here means the branch existed on entry and still exists.

    Returns (kind, branch) with kind in:
      "pushed"   — this round pushed `branch`
      "resuming" — `branch` was dispatched to this round and gained no new commits
      "unknown"  — salvage could not establish the branch state; NOT a "no" (#33 keeps the failure
                   direction: a false "nothing to resume" loses work, a false "resumable" costs a
                   checkout)
      "none"     — finalize positively knows nothing was banked
    """
    env = os.environ if env is None else env
    pushed = (stats.get("salvaged_branch") or "").strip()
    if pushed:
        return "pushed", pushed
    dispatched = (env.get("WORK_BRANCH") or "").strip()
    if dispatched:
        return "resuming", dispatched
    if stats.get("salvage_undetermined"):
        return "unknown", None
    return "none", None


def resumable_note(stats, env=None):
    """The resumable-branch sentence for the strike comment. The cases stay distinguishable —
    "resuming `B` (no new commits)" is materially different from "pushed `B`", and the coordinator
    play acts on the distinction (#33)."""
    kind, branch = resumable_branch(stats, env)
    if kind == "pushed":
        return ("\n\n**Resumable branch pushed:** `%s` — the next round can resume from it (C5), "
                "not restart." % branch)
    if kind == "resuming":
        return ("\n\n**Resumable branch:** `%s` — this round resumed it and added no new commits, "
                "so it still holds the work banked by earlier rounds. The next round must resume "
                "from it (C5), not restart from base." % branch)
    if kind == "unknown":
        return ("\n\n(resumable branch **unknown** — salvage could not establish the branch state; "
                "this is not a statement that none exists. Check the run log before restarting "
                "from base.)")
    return "\n\n(no resumable branch — nothing was committed)"


def deliberate_stop_body(stats, log_tail, env=None):
    """The `blocked-deliberate` report body — the OTHER comment the coordinator reads for the
    resumable answer, and so the other place #33 has to hold.

    It used to inline the round-scoped `stats["salvaged_branch"]` check, which reproduced this
    issue's bug through a second door and did it worse: an unset `salvaged_branch` appended nothing
    at all, and the coordinator acts on the line's PRESENCE — an omitted line and a false
    "(no resumable branch)" produce the identical decision (fork from base, discard the branch).
    One source, both call sites: `resumable_note()` answers here exactly as it does for the strike.

    Pure over (stats, log_tail, env) so the wiring is testable without `gh` or a network."""
    env = os.environ if env is None else env
    return (
        "AGENT_REPORT: deliberate stop (model=%s, round=%s, session=%s) — no PR by "
        "decision; the structured report is in the run log.%s\n\n"
        "<details><summary>last 15 log lines (%s)</summary>\n\n~~~text\n%s~~~\n\n</details>\n"
    ) % (
        env.get("MODEL") or stats.get("model", "?"),
        env.get("AGENT_ROUND", "1"), stats.get("pod", "?"),
        resumable_note(stats, env),
        stats.get("pod", "?"), log_tail,
    )


def derive_pr_url(stats):
    """Deterministic PR discovery (homelab TICK-LOG meta-7 retro (a) — the FU-079 class). The
    self-reported pr_url comes from the goose recipe's `response.json_schema`, a goose-only
    feature: claude-harness runs NEVER emit it (3/3 un-armed PRs on the subscription tier), and
    any model can simply forget it. The pod's checked-out branch is ground truth — ask GitHub
    which open PR has it as head and adopt that URL. Arming, stats-comment-vs-strike routing, and
    classification all key off pr_url, so this runs before them — but AFTER salvage_push, whose
    self-report-only skip must not be disabled by a stale still-open PR on a resumed branch.
    Rule #6: a FAILED probe is not "no PR" — pr_url stays unset and downstream keeps the
    conservative pre-existing path."""
    if stats.get("pr_url") or not shutil.which("gh"):
        return
    wd, base, branch = _resolve_branch()
    if branch is None:
        return
    try:
        probe = subprocess.run(
            ["gh", "pr", "list", "--head", branch, "--base", base, "--state", "open",
             "--json", "url", "--jq", ".[0].url // empty"],
            capture_output=True, text=True, timeout=30, env=_fresh_gh_env(), cwd=wd)
        url = probe.stdout.strip()
        if probe.returncode == 0 and url.startswith("https://"):
            stats["pr_url"] = url
            stats["pr_url_derived"] = True
            print("finalize: pr_url derived from branch %s -> %s" % (branch, url), flush=True)
    except Exception as e:
        print("finalize: pr_url derivation non-fatal error: %s" % e, file=sys.stderr)


def _last_lines(log_path, count=15):
    try:
        with open(log_path, errors="replace") as fh:
            return "".join(fh.readlines()[-count:])
    except Exception:
        return ""


# ── ADR-103 leg 2: the machine channels (homelab#210 / agent-runtime#62) ──────────────────────
# Every machine event used to be another PR comment — "picking this up (round N)", the run-stats
# table, the strike — so a three-round ride buried the human review under machine residue, and the
# coordinator's round counter rode on "one round = one more comment", which anything else
# commenting broke. Two channels replace that:
#   - the `agent-ride` CHECK-RUN carries the run-stats table (markdown output, checks tab);
#   - ONE `<!-- agent-summary -->` comment per timeline carries a one-line index entry per event,
#     APPENDED in place.
# The homelab twin (PR #219, `agents/machine-comment.sh`, merged 2026-08-09) is the reference
# implementation and already emits these shapes from the launcher's fallback leg. These are the
# same bytes, reimplemented — they are the machine interface, not cosmetics.
SUMMARY_MARKER = "<!-- agent-summary -->"
SUMMARY_HEADER = (
    SUMMARY_MARKER + "\n"
    "\U0001f916 **Agent activity** — one machine comment per timeline, appended in place "
    "(ADR-103). Run detail lives in the `agent-ride` check-run, the ledger and "
    "`s3://agent-transcripts/`; this is the index."
)
CHECK_RUN_NAME = "agent-ride"


def _utc_now_iso():
    """The event timestamp. A seam, not a convenience: the behaviour fixtures pass `now` in, so
    the recorded world has no wall clock (deliverable 4)."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def summary_event_line(markdown, kind, ts, fold=None):
    """One appended index entry, byte-identical to the launcher's.

    ⚠ `kind=stats` is LOAD-BEARING: `agents/coordinator-scan.sh` counts
    `<!-- agent-event kind=stats ts=([^ ]+) -->` inside the summary comment as the ROUND COUNTER,
    now that "one round = one more comment" is false. A different kind string or a missing marker
    silently pins ci-red `attempts` at 0 — the red-loop livelock `RED_ROUNDS_MAX` exists to bound.

    `fold` carries the run-stats table when the check-run was refused (App-token-only endpoint):
    it rides INSIDE this one entry as an indented list continuation — never as a second comment,
    which would undo the whole change. The marker stays on the FIRST physical line so the scan's
    line-oriented grep is unaffected.
    """
    line = "- `%s` · %s <!-- agent-event kind=%s ts=%s -->" % (ts, markdown, kind, ts)
    if fold:
        table = "\n".join(("  " + ln) if ln.strip() else "" for ln in fold.rstrip("\n").split("\n"))
        line += ("\n  <details><summary>run stats (check-run unavailable — App-token-only "
                 "endpoint)</summary>\n\n%s\n\n  </details>" % table)
    return line


def parse_comment_pages(text):
    """`gh api --paginate` output → a flat list of comments, or None when it is UNREADABLE.

    None is the fail-closed signal (rule #6, the probe-fails-into-a-value class): an empty or
    non-array payload is not an empty timeline, and a caller that treated it as one would create a
    second summary comment on every event — precisely the residue this work removes. `--paginate`
    concatenates one JSON array per page, so decode until the text runs out.
    """
    text = text or ""
    dec = json.JSONDecoder()
    out, i, decoded_a_page = [], 0, False
    while i < len(text):
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        try:
            page, i = dec.raw_decode(text, i)
        except ValueError:
            return None
        if not isinstance(page, list):
            return None  # an API error object ({"message": "Not Found"}) is not a timeline
        out.extend(page)
        decoded_a_page = True
    return out if decoded_a_page else None


def summary_pick(comments):
    """The find half of find-or-create: the OLDEST `<!-- agent-summary -->` comment, or None.

    Oldest, not newest: a race — or a human pasting the marker — must converge back onto the FIRST
    comment instead of alternating between two.
    """
    marked = [c for c in comments
              if isinstance(c, dict) and SUMMARY_MARKER in (c.get("body") or "")]
    if not marked:
        return None
    marked.sort(key=lambda c: (str(c.get("created_at") or ""), str(c.get("id") or "")))
    return marked[0]


def post_summary_event(gh, slug, issue, markdown, kind, ts, fold=None):
    """Find-or-create the single summary comment and APPEND one event line. True when it landed.

    REST only (`repos/{slug}/issues/{n}/comments`) — a PR's conversation comments ARE issue
    comments, so one endpoint serves both sides, and the id this returns is the REST-numeric `.id`
    the PATCH needs (a GraphQL node id 404s that endpoint).

    APPEND, never replace: replacing would erase round 1's `kind=stats` marker and hand the
    coordinator's counting clause a permanent `attempts=1`.

    Never fatal — this is bookkeeping, and no ride may lose real work over a refused comment.
    """
    line = summary_event_line(markdown, kind, ts, fold)
    listed = gh("api", "--paginate", "repos/%s/issues/%s/comments" % (slug, issue))
    if listed.returncode != 0:
        print("summary-comment: timeline read FAILED: %s — creating NOTHING (fail closed)"
              % listed.stderr.strip()[-200:], file=sys.stderr)
        return False
    comments = parse_comment_pages(listed.stdout)
    if comments is None:
        print("summary-comment: timeline unreadable (no JSON array in %d bytes of gh output) — "
              "creating NOTHING (fail closed; a create here would mint a second summary comment)"
              % len(listed.stdout or ""), file=sys.stderr)
        return False
    target = summary_pick(comments)
    if target is None:
        wrote = gh("api", "--method", "POST", "repos/%s/issues/%s/comments" % (slug, issue),
                   "--input", "-", stdin=json.dumps({"body": SUMMARY_HEADER + "\n\n" + line}))
        what = "created"
    else:
        body = (target.get("body") or "").rstrip("\n") + "\n" + line
        wrote = gh("api", "--method", "PATCH",
                   "repos/%s/issues/comments/%s" % (slug, target.get("id")),
                   "--input", "-", stdin=json.dumps({"body": body}))
        what = "appended to comment %s" % target.get("id")
    if wrote.returncode != 0:
        print("summary-comment: %s FAILED: %s (non-fatal)" % (what, wrote.stderr.strip()[-200:]),
              file=sys.stderr)
        return False
    print("summary-comment: %s (kind=%s)" % (what, kind), flush=True)
    return True


def check_run_payload(head_sha, task, table):
    """The `agent-ride` check-run body. `neutral` is deliberate: an informational check must never
    colour mergeability, and this is not a required context."""
    return {
        "name": CHECK_RUN_NAME,
        "head_sha": head_sha,
        "status": "completed",
        "conclusion": "neutral",
        "output": {"title": "agent ride — %s" % (task or "adhoc"), "summary": table},
    }


def post_check_run(gh, slug, pr_url, task, table):
    """POST the run-stats table as the `agent-ride` check-run on the PR head sha.

    False (never an exception) when it could not be posted — check-runs are an App-token-only
    endpoint, so a classic PAT 403s here whatever its scopes; the caller degrades by folding the
    table into the summary line. The head sha is asked of GitHub rather than of the local checkout:
    a guessed sha attaches the check to nothing.
    """
    head = gh("pr", "view", pr_url, "--json", "headRefOid", "--jq", ".headRefOid")
    sha = head.stdout.strip() if head.returncode == 0 else ""
    if not sha:
        print("check-run: head sha unreadable (%s) — no check-run (table folds into the summary "
              "line)" % (head.stderr.strip()[-160:] or "empty"), file=sys.stderr)
        return False
    posted = gh("api", "--method", "POST", "repos/%s/check-runs" % slug, "--input", "-",
                stdin=json.dumps(check_run_payload(sha, task, table)))
    if posted.returncode != 0:
        print("check-run: POST refused: %s — folding the table into the summary line "
              "(App-token-only endpoint)" % posted.stderr.strip()[-200:], file=sys.stderr)
        return False
    print("check-run: %s posted on %s" % (CHECK_RUN_NAME, sha[:12]), flush=True)
    return True


def _cost_cell(stats):
    """The one cost expression, shared by the table and the index line."""
    if "cost_usd" in stats:
        return "$%s" % stats["cost_usd"]
    if stats.get("subscription"):
        return "subscription — %s turns, %s in (+%s cached) / %s out tok" % (
            stats.get("turns", "?"), stats.get("tokens_in", "?"),
            stats.get("tokens_cache_read", 0), stats.get("tokens_out", "?"))
    return "unknown (key unreadable)"


def run_stats_table(stats, task):
    """The run-stats markdown table — the payload that used to BE a PR comment and is now the
    check-run's output summary. Unchanged bytes (transcripts pointer + cost line included); only
    the channel moved, and the ledger/S3 copy is untouched either way."""
    rail_row = "| rail | `%s` |\n" % stats["rail"] if "rail" in stats else ""
    return (
        "\U0001f916 **Agent run stats** (posted in-pod)\n\n"
        "| metric | value |\n|---|---|\n"
        "| model | `%s` (%s) |\n"
        "| cost | %s |\n"
        "| duration | %ss |\n"
        "| ci_passed | %s |\n"
        "| exit / error_class | `%s` / `%s` |\n"
        "| node / pod | `%s` / `%s` |\n"
        "%s"
        "\n\U0001f5c2 transcripts: `s3://agent-transcripts/%s/%s/`"
    ) % (
        stats.get("model", "?"), stats.get("harness", "?"), _cost_cell(stats),
        stats.get("duration_s", 0), stats.get("ci_passed", "?"),
        stats.get("exit_status", "?"), stats.get("error_class", "") or "clean",
        stats.get("node", "?"), stats.get("pod", "?"),
        rail_row,
        stats.get("project", "?"), task or "adhoc",
    )


def _pr_number(pr_url):
    m = re.search(r"/pull/(\d+)", pr_url or "")
    return m.group(1) if m else ""


def _slug_from_pr_url(pr_url):
    m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/\d+", pr_url or "")
    return m.group(1) if m else ""


def emit_run_stats(gh, stats, task, slug, now=None):
    """The stats channel: table → `agent-ride` check-run, one index line → the summary comment.

    Sets `stats_comment_by_pod` ONLY on a real ADR-103 emission, because that flag is a
    SUPPRESSION CONTRACT with the merged launcher: `agents/agent-session.sh` skips its ENTIRE
    fallback bookkeeping leg when `armed_by_pod` and `stats_comment_by_pod` are both true. Setting
    it while posting the OLD table is the bug this fixes — it suppressed the launcher's new-shape
    leg, so a real ride produced the old residue and no check-run at all. Left UNSET when the
    emission failed, which means "the pod never got to it" and lets the fallback post the stats.
    """
    pr_url = stats.get("pr_url") or ""
    slug = slug or _slug_from_pr_url(pr_url)  # REPO_URL is launcher-injected; the PR URL is not
    issue = _pr_number(pr_url)
    if not (slug and issue):
        print("stats: no repo slug / PR number (%r) — stats channel skipped, launcher fallback "
              "posts" % pr_url, file=sys.stderr)
        return False
    table = run_stats_table(stats, task)
    on_check_run = post_check_run(gh, slug, pr_url, task, table)
    index = "**run stats (round %s)** — model `%s` · exit `%s` · %s · %ss" % (
        os.environ.get("AGENT_ROUND", "1"), stats.get("model", "?"),
        stats.get("exit_status", "?"), _cost_cell(stats), stats.get("duration_s", 0))
    if on_check_run:
        index += " — detail in the `%s` check-run." % CHECK_RUN_NAME
    emitted = post_summary_event(gh, slug, issue, index, "stats", now or _utc_now_iso(),
                                 fold=None if on_check_run else table)
    if emitted:
        stats["stats_comment_by_pod"] = True
    return emitted


# ── ADR-097 leg (homelab#379 worker half / #70): the deterministic Touches-escapes block ─────
# The worker's JUSTIFICATION of each escape stays a recipe instruction; the LIST is finalize's
# fact. Computed from git (the changed paths) × the issue's declared `Touches:` footprint with the
# canonical matcher's semantics (homelab `agents/touches-check.sh` / `footprint.sh`, ADR-097), then
# appended to the PR body the same edit-in-place discipline as `<!-- agent-summary -->`: round 2
# rewrites round 1's block, it does not stack a second one.
TOUCHES_BLOCK_BEGIN = "<!-- agent-touches: begin -->"
TOUCHES_BLOCK_END = "<!-- agent-touches: end -->"
# Governance tier (carried from the shell helper): an escaped path under one of these prefixes
# rides as `path|governance`, so the homelab reviewer's BLOCKING finding is not silently dropped.
GOVERNANCE_PREFIXES = ("agents/", ".agents/", "scripts/", "policy/", ".github/",
                       "tofu/github/", "tofu/cloudflare/")


def _normalize_footprint(entry):
    """ADR-097 normalization of one `Touches:` entry: cut at the FIRST `*`, strip one trailing `/`.

    `chassis/**` → `chassis/` → `chassis`. A leading-`*` entry (`**/x.py`) cuts to the EMPTY
    prefix — the everything-match, conservative by construction. Mirror of homelab
    `agents/footprint.sh` (ADR-097)."""
    prefix = entry.split("*", 1)[0]
    if prefix.endswith("/"):
        prefix = prefix[:-1]
    return prefix


def footprint_overlap(a, b):
    """Path-boundary-aware prefix overlap (homelab `agents/touches-check.sh`, ADR-097).

    `a` overlaps `b` iff `a == b`, `a` starts with `b + "/"`, or `b` starts with `a + "/"` — NOT
    raw string-prefix (`chassis` vs `chassis-x` do NOT overlap). Either side normalizing to the
    empty prefix (a leading-`*` entry) matches everything."""
    if not a or not b:
        return True
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def parse_touches_footprint(issue_body):
    """The issue body's declared `Touches:` line → the normalized footprint entries, or None.

    None is UNDECLARED: no `Touches:` line, an empty value, or a bare `*` — each means the issue
    declared no reviewable footprint and every changed path escapes. Absent must be None, never []
    and never a crash. Whitespace around comma-separated entries is stripped and empty entries are
    dropped; an entry that normalizes to the empty prefix stays as "" (it matches everything)."""
    if not issue_body:
        return None
    for line in issue_body.splitlines():
        m = re.match(r"^\s*Touches\s*:\s*(.*?)\s*$", line, re.IGNORECASE)
        if not m:
            continue
        value = m.group(1).strip()
        if not value or value == "*":
            return None
        return [_normalize_footprint(e.strip()) for e in value.split(",") if e.strip()]
    return None


def _governance_suffix(path):
    """`|governance` for an escaped path in the governance tier — carried, never dropped."""
    return "|governance" if path.startswith(GOVERNANCE_PREFIXES) else ""


def touches_escapes(footprint, changed_paths):
    """The escape set: changed paths that do NOT overlap the declared footprint.

    Returns (undeclared, escapes). undeclared=True when `footprint` is None — the issue declared
    no reviewable footprint, so EVERY changed path escapes and the block is `Touches: undeclared`
    (never a path list). Otherwise a changed path escapes iff it does not overlap ANY declared
    entry — the changed path rides as a singleton footprint entry through the conflict test."""
    if footprint is None:
        return True, list(changed_paths)
    escapes = [p for p in changed_paths
               if not any(footprint_overlap(_normalize_footprint(p), f) for f in footprint)]
    return False, escapes


def touches_block(issue_body, changed_paths):
    """The machine-readable Touches block for the PR body (ADR-097, #70) — the escape LIST as a
    fact: `Touches: undeclared`, `Touches-escapes: none`, or `Touches-escapes: <paths>` with
    governance-marked entries, wrapped in the HTML markers that make the append idempotent."""
    undeclared, escapes = touches_escapes(parse_touches_footprint(issue_body), changed_paths)
    if undeclared:
        line = "Touches: undeclared"
    elif not escapes:
        line = "Touches-escapes: none"
    else:
        line = "Touches-escapes: " + ",".join(p + _governance_suffix(p) for p in escapes)
    return "%s\n%s\n%s" % (TOUCHES_BLOCK_BEGIN, line, TOUCHES_BLOCK_END)


def append_touches_block(body, block):
    """Insert `block` into a PR body, REPLACING any previous one (edit-in-place, the
    `<!-- agent-summary -->` discipline): round 2 rewrites round 1's block instead of stacking a
    second one. Returns the new body."""
    body = body or ""
    if TOUCHES_BLOCK_BEGIN in body:
        before, _, after_begin = body.partition(TOUCHES_BLOCK_BEGIN)
        _, _, after_end = after_begin.partition(TOUCHES_BLOCK_END)
        return before.rstrip() + "\n" + block + after_end
    body = body.rstrip()
    return (body + "\n" + block) if body else block


def _changed_paths(wd, base):
    """`git diff --name-only <base>...HEAD` (MERGE-BASE, not base TIP — #75) → the changed paths,
    or None when the diff is UNREADABLE (rule #6: a failed probe is not "no changes" — that would
    fabricate `Touches-escapes: none` for a change set finalize cannot see).

    The three-dot form is deliberate. Two-dot (`<base>..HEAD`) compares the base TIP against HEAD,
    so once the updater workflow merges a moved master into an in-flight PR branch, every path other
    PRs landed on master during the review cycle shows up as changed and emits a FALSE escape —
    any of them outside the issue's `Touches:` footprint rides as a narrow- or governance-BLOCKING
    finding. The merge-base compare (what GitHub's own `.files` reports) sees only this PR's work."""
    try:
        r = subprocess.run(["git", "-C", wd, "diff", "--name-only", "%s...HEAD" % base],
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        print("touches: git diff failed: %s — block skipped" % e, file=sys.stderr)
        return None
    if r.returncode != 0:
        print("touches: git diff failed: %s — block skipped"
              % (r.stderr.strip()[-200:] or "exit %s" % r.returncode), file=sys.stderr)
        return None
    return [ln for ln in r.stdout.splitlines() if ln.strip()]


def _fetch_issue_body(gh, slug, issue):
    """`gh issue view <n> --repo <slug> --json body --jq .body` → the issue body, or None when
    UNREADABLE (a failed read is not a body without a `Touches:` line — that would land every
    issue as `Touches: undeclared`)."""
    r = gh("issue", "view", issue, "--repo", slug, "--json", "body", "--jq", ".body")
    if r.returncode != 0:
        print("touches: issue body read FAILED: %s — block skipped"
              % r.stderr.strip()[-200:], file=sys.stderr)
        return None
    return r.stdout or ""


def post_touches_block(gh, slug, pr_url, issue):
    """Compute and append the ADR-097 Touches block to the PR body (#70).

    Deterministic and model-independent — the escape LIST is finalize's fact, computed from git ×
    the issue's declared footprint; per-escape justification prose stays a recipe instruction.
    Best-effort like all of bookkeeping: an unreadable input or a refused edit is a stderr line and
    a normal return — never a failed run, and never a fabricated block."""
    body = _fetch_issue_body(gh, slug, issue)
    if body is None:
        return
    wd, base, _branch = _resolve_branch()
    changed = _changed_paths(wd, base)
    if changed is None:
        return
    block = touches_block(body, changed)
    cur = gh("pr", "view", pr_url, "--json", "body", "--jq", ".body")
    if cur.returncode != 0:
        print("touches: PR body read FAILED: %s — block not appended"
              % cur.stderr.strip()[-160:], file=sys.stderr)
        return
    new_body = append_touches_block(cur.stdout, block)
    if new_body == cur.stdout:
        return  # already present and unchanged — idempotent across rounds
    edited = gh("pr", "edit", pr_url, "--body", new_body)
    if edited.returncode != 0:
        print("touches: PR body edit FAILED: %s (non-fatal)"
              % edited.stderr.strip()[-200:], file=sys.stderr)
        return
    print("touches: Touches block appended to %s" % pr_url, flush=True)


# ── homelab#501 worker half (#73): the deterministic PR-open label flip ────────────────────────
# At PR-open, beside arming auto-merge, flip the source issue out of `agent/in-progress` and into
# `agent/review` — the deterministic lifecycle edge: today NOTHING writes `agent/review`; it happens
# only when an LLM session happens to visit, so footprint release is arbitrary. The issue number is
# read from the STRONG LINK finalize guarantees in the PR body (`Implements #N` / `Fixes #N`,
# agent-runtime#34), never from the task string. Ordering per homelab IL-T16: add FIRST, remove
# SECOND — the write is not atomic, and removing first would leave the issue label-less in the
# window. Idempotent (gh's edit is a no-op for a label already in the target state — the homelab
# scan belt runs the same flip level-triggered and either side may win the race) and never fatal (a
# refused write is a stderr line; the belt reconciles within a scan tick, homelab#501 deliverable 1).
STRONG_LINK_RE = re.compile(r"\b(?:Implements|Fixes)\s+#(\d+)\b")


def parse_strong_link(body):
    """The issue number in finalize's STRONG link (agent-runtime#34): the `Implements #N` line the
    #32 guarantee maintains, or the recipe's `Fixes #N` — the same link the coordinator scan reads
    to connect a PR to its issue. `Refs #N` is deliberately NOT strong: it declares a PARTIAL
    delivery, and only a strong link says the issue's work is actually in the PR. None when absent
    — a body without a strong link has nothing deterministic to flip (the belt reconciles)."""
    if not body:
        return None
    m = STRONG_LINK_RE.search(body)
    return m.group(1) if m else None


def flip_issue_to_review(gh, slug, pr_url):
    """Flip the PR's source issue to `agent/review` at PR-open (homelab#501 cause half).

    The issue number comes from the STRONG LINK in the PR body (see `parse_strong_link`), which
    the #32 guarantee above has already ensured — not from the task string, so the flip tracks the
    issue the coordinator scan will actually link and release. Ordering per homelab IL-T16:
    `agent/review` is ADDED before `agent/in-progress` is REMOVED, and a FAILED add skips the remove
    — a label-less issue (neither in-progress nor review) is the exact state the ordering exists to
    prevent. Best-effort like every leg: an unreadable body, a missing link, or a refused write is
    a stderr line and a normal return — the homelab-side scan belt reconciles the flip within a
    scan tick (homelab#501 deliverable 1)."""
    cur = gh("pr", "view", pr_url, "--json", "body", "--jq", ".body")
    if cur.returncode != 0:
        print("label-flip: PR body read FAILED: %s (belt reconciles)"
              % cur.stderr.strip()[-200:], file=sys.stderr)
        return
    issue = parse_strong_link(cur.stdout)
    if issue is None:
        print("label-flip: no strong link in PR body — nothing to flip (belt reconciles)",
              file=sys.stderr)
        return
    added = gh("issue", "edit", issue, "--repo", slug, "--add-label", "agent/review")
    if added.returncode != 0:
        print("label-flip: add agent/review FAILED on %s#%s: %s (belt reconciles)"
              % (slug, issue, added.stderr.strip()[-200:]), file=sys.stderr)
        return
    removed = gh("issue", "edit", issue, "--repo", slug, "--remove-label", "agent/in-progress")
    if removed.returncode != 0:
        print("label-flip: remove agent/in-progress FAILED on %s#%s: %s (belt reconciles)"
              % (slug, issue, removed.stderr.strip()[-200:]), file=sys.stderr)
        return
    print("label-flip: %s#%s → agent/review (agent/in-progress removed)" % (slug, issue),
          flush=True)


def bookkeeping(stats, log_path):
    """In-pod GitHub bookkeeping (FU-064/FU-043): with a PR from a round that ENDED — arm
    auto-merge (an un-armed PR is invisible to the ENTIRE merge path: updater, review reflex,
    GitHub auto-merge) + emit the stats channels (ADR-103: the `agent-ride` check-run + one
    appended summary line, #62); otherwise — post the AGENT_STRIKE comment to the
    issue (that comment IS the strike store the coordinator walks the model chain by; keep the
    first line's format STABLE). Sets *_by_pod flags in stats so the launcher's fallback skips what
    already happened.

    The route is `bookkeeping_route(stats)`, not `if pr_url` (#49): a PR says an artifact exists,
    never that THIS round produced it or survived. The issue link (#32) is the one step that stays
    keyed to the PR alone — see the route function."""
    if not shutil.which("gh"):
        print("bookkeeping: gh not in image — left to the launcher fallback", file=sys.stderr)
        return
    env = _fresh_gh_env()

    def gh(*args, timeout=30, stdin=None):
        # stdin feeds `gh api --input -`: the check-run payload is a nested object, which no
        # combination of -f/-F expresses portably across gh versions.
        return subprocess.run(["gh", *args], capture_output=True, text=True, timeout=timeout,
                              env=env, input=stdin)

    pr_url = stats.get("pr_url") or ""
    route = bookkeeping_route(stats)
    task = os.environ.get("AGENT_TASK") or ""
    repo_url = os.environ.get("REPO_URL") or ""
    slug = ""
    if repo_url.startswith("https://github.com/"):
        slug = repo_url[len("https://github.com/"):].removesuffix(".git")

    try:
        # AGENT_ARM_PR=0 (launcher --no-arm): roles whose PR is deliberately HUMAN-GATED —
        # arm-at-open (homelab MP-T01) is the worker default, but an un-armed PR is the
        # researcher role's gate (homelab FU-105; found live 2026-07-27: finalize armed the
        # first spec PR right past the recipe's "do not arm").
        if pr_url:
            if route != "arm":
                # This round DIED holding an earlier round's PR (#49). Arming it would declare the
                # dead round's work mergeable on the strength of an artifact it did not produce.
                # The flag is set FALSE, not left unset: unset means "the pod never got to it" and
                # the launcher's fallback arms it, which would undo this decision one layer up.
                stats["armed_by_pod"] = False
                print("bookkeeping: arming + stats channel SKIPPED (exit_status=%s — THIS ROUND "
                      "died; the PR is an earlier round's artifact). Striking instead."
                      % (stats.get("exit_status") or "?"), flush=True)
            elif os.environ.get("AGENT_ARM_PR", "1") == "0":
                stats["armed_by_pod"] = False
                print("bookkeeping: arming SKIPPED (AGENT_ARM_PR=0 — human-gated PR)", flush=True)
            else:
                armed = gh("pr", "merge", pr_url, "--auto", "--squash")
                if armed.returncode == 0:
                    stats["armed_by_pod"] = True
                    print("bookkeeping: auto-merge armed on " + pr_url, flush=True)
                else:
                    print("bookkeeping: arm FAILED: %s (launcher/reflex re-arms)"
                          % armed.stderr.strip()[-200:], file=sys.stderr)
            # ── GUARANTEE THE ISSUE LINK (#32) ────────────────────────────────────────────────
            # The coordinator scan links a PR to its issue by TEXT — `#<n>` anywhere in the body —
            # not by GitHub's closing references, because a PR based on a non-default branch has
            # none. An in-progress issue with no open PR body matching `#<n>` reads as "worker
            # terminal, no PR" and gets RE-DISPATCHED onto finished work.
            # Recipes are the wrong place for this: fix.yaml asks for it, build.yaml does not (in
            # both repos that have one), and a rule a model can forget is advice, not mechanism.
            # Cost of forgetting it live (circles#30/#36, 2026-08-06): a duplicate ride onto merged
            # work, plus a goal child that could never close — homelab FU-143's soak failed on
            # exactly this, and the scan now has to HOLD such issues because it cannot tell
            # merged-but-unlinked from abandoned.
            # ⚖ `Implements`, never `Fixes`: on a `goal/**` base a closing keyword is inert, and on
            # master it would make the PR close an issue the goal lane still owns. This line exists
            # to satisfy the scan's regex, NOT to change what merging does.
            # ⚖ Match, do not duplicate; prepend, do not rewrite; never fatal.
            if task.startswith("issue-") and slug:
                _issue = task[len("issue-"):]
                try:
                    _cur = gh("pr", "view", pr_url, "--json", "body", "--jq", ".body")
                    if _cur.returncode != 0:
                        print("bookkeeping: issue-link read FAILED: %s (scan may re-dispatch %s#%s)"
                              % (_cur.stderr.strip()[-160:], slug, _issue), file=sys.stderr)
                    elif re.search(r"\b(?:Implements|Fixes)\s+#%s\b" % re.escape(_issue), _cur.stdout):
                        print("bookkeeping: issue link already present (#%s) — left alone" % _issue,
                              flush=True)
                    else:
                        _new = "Implements #%s\n\n%s" % (_issue, _cur.stdout)
                        _ed = gh("pr", "edit", pr_url, "--body", _new)
                        if _ed.returncode == 0:
                            print("bookkeeping: issue link ADDED (Implements #%s) — the PR body did "
                                  "not name its issue" % _issue, flush=True)
                            stats["issue_link_added_by_pod"] = True
                        else:
                            print("bookkeeping: issue-link edit FAILED: %s (scan may re-dispatch "
                                  "%s#%s)" % (_ed.stderr.strip()[-160:], slug, _issue),
                                  file=sys.stderr)
                except Exception as exc:  # never turn a good ride into a failed one
                    print("bookkeeping: issue-link step errored: %r (non-fatal)" % exc,
                          file=sys.stderr)
                if route == "arm":
                    # ADR-097 (homelab#379 worker half / #70): the deterministic Touches block.
                    # The escape LIST is computed from git × the issue's declared footprint —
                    # never the model — and appended edit-in-place, idempotently across rounds.
                    # Rides the ARM leg like the stats channel: a died round holding an earlier
                    # round's PR leaves the body alone. Same never-fatal discipline as the issue
                    # link above.
                    try:
                        post_touches_block(gh, slug, pr_url, _issue)
                    except Exception as exc:
                        print("bookkeeping: touches-block step errored: %r (non-fatal)" % exc,
                              file=sys.stderr)
            if route == "arm":
                # homelab#501 worker half (#73): at PR-open, flip the source issue to
                # `agent/review` — add first, remove `agent/in-progress` second (homelab IL-T16).
                # The issue number is the STRONG LINK in the PR body, which the #32 step above just
                # guaranteed. Best-effort like every leg: a failed flip is logged and the
                # homelab-side belt reconciles it within a scan tick.
                if slug:
                    try:
                        flip_issue_to_review(gh, slug, pr_url)
                    except Exception as exc:  # never turn a good ride into a failed one
                        print("bookkeeping: label-flip step errored: %r (non-fatal)" % exc,
                              file=sys.stderr)
                # ADR-103 leg 2 (#62): the table is the `agent-ride` check-run and the PR gets ONE
                # appended index line — no more `gh pr comment` per round. `stats_comment_by_pod`
                # is set inside, and only on a real emission (it suppresses the launcher's
                # new-shape fallback leg).
                emit_run_stats(gh, stats, task, slug)
        # Not `elif`: a died round reaches BOTH legs — the PR above still gets its issue link, and
        # the strike below is the whole point of #49.
        if route != "arm" and task.startswith("issue-") and slug:
            issue = task[len("issue-"):]
            if route == "deliberate-stop":
                # NOT a strike (a strike means "the run died — walk the model chain"); a
                # deliberate stop is the worker's judgment call, reported for the coordinator.
                # Issue-scoped, not round-scoped (#33) — same answer as the strike path below, from
                # the same function: this report is read by the same coordinator for the same
                # re-dispatch decision.
                body = deliberate_stop_body(stats, _last_lines(log_path))
                posted = gh("issue", "comment", issue, "--repo", slug, "--body", body)
                if posted.returncode == 0:
                    stats["strike_by_pod"] = True  # suppresses the launcher's fallback strike
                    print("bookkeeping: deliberate-stop report posted to %s#%s" % (slug, issue),
                          flush=True)
                else:
                    print("bookkeeping: deliberate-stop comment FAILED: %s (launcher fallback "
                          "posts a strike instead)" % posted.stderr.strip()[-200:],
                          file=sys.stderr)
                return
            err = stats.get("error_class") or "unknown"
            if stats.get("exit_status") in ("failed", "ci-failed"):
                err = "unknown"
            strike = "AGENT_STRIKE: model=%s error_class=%s round=%s session=%s" % (
                os.environ.get("MODEL") or stats.get("model", "?"), err,
                os.environ.get("AGENT_ROUND", "1"), stats.get("pod", "?"),
            )
            # Issue-scoped, not round-scoped (#33): the coordinator reads this to decide whether to
            # re-dispatch with --work-branch, so a resumed round that committed nothing must still
            # name the branch it resumed.
            salvage_note = resumable_note(stats)
            body = "%s%s\n\n<details><summary>last 15 log lines (%s)</summary>\n\n~~~text\n%s~~~\n\n</details>\n" % (
                strike, salvage_note, stats.get("pod", "?"), _last_lines(log_path))
            posted = gh("issue", "comment", issue, "--repo", slug, "--body", body)
            if posted.returncode == 0:
                stats["strike_by_pod"] = True
                print("bookkeeping: strike posted to %s#%s" % (slug, issue), flush=True)
            else:
                print("bookkeeping: strike comment FAILED: %s (launcher fallback posts it)"
                      % posted.stderr.strip()[-200:], file=sys.stderr)
    except Exception as e:
        print("bookkeeping: non-fatal error: %s" % e, file=sys.stderr)


def _seg(v):
    """URL-path-safe pushgateway grouping-key segment. Empty is NOT a legal grouping label value —
    a `//` in the path makes the gateway reject the whole push — so an unknown rides as "unknown".
    Shared by both pushers so the two group paths cannot escape differently."""
    return urllib.parse.quote(str(v) if v is not None else "", safe="") or "unknown"


def _lv(v):
    """Prometheus label-value escaping. Shared for the same reason as `_seg`: `agent_run`'s labels
    come from env/stats, `agent_run_phase`'s come from a file the entrypoint writes, and both are
    exposition text where an unescaped quote or newline forges a sample."""
    return str(v).replace("\\", r"\\").replace('"', r"\"").replace("\n", r"\n")


def _issue_segment():
    """`AGENT_TASK` → the `issue` grouping-label value, exactly as the launcher derives it: strip a
    leading `issue-`, leave everything else alone (so a `pr-12` ride stays `pr-12`)."""
    task = os.environ.get("AGENT_TASK") or "adhoc"
    return task[len("issue-"):] if task.startswith("issue-") else task


# ── FU-160 in-pod half (#66): the ride's INTERIOR ─────────────────────────────────────────────
# The launcher (homelab agents/agent-session.sh) owns four phases — dispatch-gates, pod-spinup,
# ride, bookkeeping — where `ride` is the ENVELOPE around everything this repo does. A growing
# `ride` bar therefore says WHERE to look and nothing about what happened. These functions emit
# the pod's own share of that interval into the same metric family.
PHASE_JOB = "agent_run_phase"
PHASE_SOURCE = "in-pod"
# A phase name becomes a Prometheus label value and a path-free token, and it arrives from SHELL.
# Anything outside this alphabet is refused at the door rather than escaped downstream.
PHASE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$")


def _marks_path():
    return os.environ.get("AGENT_PHASE_MARKS") or PHASE_MARKS


def mark_phase(phase, seconds, path=None):
    """Record one CLOSED in-pod phase: `agent-finalize --mark <phase> <seconds>`.

    The entrypoint is the only thing in the pod that can see where the clone and `devbox install`
    end — both finish before `--snapshot` even runs — so it needs a way to hand finalize a span.
    The file format has exactly ONE writer (here) so a shell half and a python half cannot drift.

    Refuses rather than guesses: a name outside `PHASE_NAME_RE`, or a duration that is not a
    non-negative number, writes NOTHING. Returns True only when a line landed, and never raises —
    the entrypoint runs under `set -e` and a stats mark may not fail a ride.
    """
    name = str(phase).strip()
    try:
        value = float(seconds)
    except (TypeError, ValueError):
        value = None
    if not PHASE_NAME_RE.match(name) or value is None or not value >= 0:
        print("phase-mark: refusing %r=%r (want a named, non-negative duration in seconds)"
              % (phase, seconds), file=sys.stderr)
        return False
    try:
        with open(path or _marks_path(), "a") as fh:
            fh.write("%s %.3f\n" % (name, value))
        return True
    except Exception as e:
        print("phase-mark: %s not recorded: %s (non-fatal)" % (name, e), file=sys.stderr)
        return False


def read_phase_marks(path=None):
    """The marks file → {phase: seconds}, in the order the phases closed.

    Absent file, unreadable file, garbled line: that row is simply not there. A line that cannot
    be parsed is DROPPED, never interpolated — a wrong span on the panel is worse than a missing
    one, and this whole family is best-effort observability.
    """
    out = {}
    try:
        with open(path or _marks_path(), errors="replace") as fh:
            lines = fh.readlines()
    except Exception:
        return out
    for line in lines:
        parts = line.split()
        if len(parts) != 2 or not PHASE_NAME_RE.match(parts[0]):
            continue
        try:
            value = float(parts[1])
        except ValueError:
            continue
        if value >= 0:
            out[parts[0]] = value  # last write wins: a re-marked phase corrects itself
    return out


def phase_durations(marks, start_epoch, finalize_epoch, now):
    """The in-pod phase table: the entrypoint's marks + the two spans finalize measures itself.

    Pure over its inputs, so the arithmetic is testable without a ride:
      `llm-loop` = --snapshot (the end of prep) → finalize's first statement. The harness/LLM loop,
                   including whatever gates the model ran inside it — those are the model's own
                   `devbox run ci` invocations and the pod cannot see their boundaries from here.
      `finalize` = that instant → now. The terminal in-pod leg: usage settle, salvage push, PR
                   arm + issue link, the summary/strike comments.

    A span whose two ends are not both known is OMITTED, never emitted as 0 — the #12 class on the
    duration side. A 0s `llm-loop` is a fabricated measurement that reads, on the panel, as a ride
    whose model never ran, and is indistinguishable from a genuinely instant one.
    """
    out = dict(marks or {})
    if finalize_epoch is None or now is None:
        return out
    if start_epoch is not None:
        # max(): a backwards clock is not a negative span. Both ends are KNOWN here, so this is a
        # clamp on a bad measurement, not a probe failing into a value.
        out["llm-loop"] = round(max(0.0, float(finalize_epoch) - float(start_epoch)), 3)
    out["finalize"] = round(max(0.0, float(now) - float(finalize_epoch)), 3)
    return out


def phase_group_path(project, issue, rnd, source=PHASE_SOURCE):
    """The pushgateway grouping key for the IN-POD phases — the design decision of #66.

    The launcher pushes its four phases into
      /metrics/job/agent_run_phase/project/<p>/issue/<n>/round/<r>/role/worker
    and re-pushes the WHOLE family on every phase close, because a push replaces same-named
    metrics within a group. Pushing these rows into that same group would make the two sides
    clobber each other — and the launcher's final `bookkeeping` push happens AFTER this pod is
    gone, so the in-pod rows are the ones that would lose: silently, in production only.

    So: the same JOB, one EXTRA grouping label `source=in-pod` (option 1 of the issue). A distinct
    grouping key is a distinct group, so neither side can delete the other's series, and NO
    homelab change is required — the dashboard panels aggregate `by (phase)` and the
    `AgentRunPhaseSlow` alert joins `and on (project, issue, round, role)`, both of which keep
    matching. A separate job (option 2) would be a cleaner separation on paper, but the alert and
    the three panels pin `job="agent_run_phase"` and would go blind to exactly the rows this adds.

    ⚠ Known imprecision, stated rather than hidden: two `push_time_seconds{job="agent_run_phase"}`
    series now exist per ride, so the alert's freshness clause is satisfied when EITHER group is
    fresh.
    """
    return "/metrics/job/%s/project/%s/issue/%s/round/%s/role/worker/source/%s" % (
        PHASE_JOB, _seg(project), _seg(issue), _seg(rnd), _seg(source),
    )


def phase_metrics_body(phases):
    """The exposition body. The contract is fixed by consumers that already exist (three dashboard
    panels + the alert): metric `agent_run_phase_seconds`, gauge, ONE label `phase`, value in
    seconds. No extra labels — the launcher's rows carry none, and a split label set is how a
    `by (phase)` panel quietly grows a second series per ride."""
    if not phases:
        return ""
    # The HELP line is byte-identical with the launcher's (homelab agents/agent-session.sh) ON
    # PURPOSE: HELP is per metric NAME, and the pushgateway merges every group's copy of the
    # family on each scrape — a differing (or missing) help string is resolved by picking a
    # winner and logging the whole ~256KB family per conflicting group pair, per scrape
    # (prometheus/pushgateway#194). With hundreds of ride groups that was 48GiB/day of log
    # volume — 98% of everything Loki ingested (homelab#811). Change it only together with the
    # launcher's copy, never alone.
    lines = [
        "# TYPE agent_run_phase_seconds gauge",
        "# HELP agent_run_phase_seconds Seconds this ride spent in one LAUNCHER-owned phase; the in-pod breakdown belongs to agent-finalize (FU-160).",
    ]
    for name, seconds in phases.items():
        lines.append('agent_run_phase_seconds{phase="%s"} %s' % (_lv(name), seconds))
    return "\n".join(lines) + "\n"


def push_phase_metrics(phases, stats):
    """Push the in-pod phase table (#66). Best-effort in every direction, exactly like its
    `agent_run` sibling: no gateway configured, an unreachable one, or nothing measured is a
    stderr line and a normal return — never a failed run.

    PUT, not POST: this group is exclusively the pod's (nothing else sets `source=in-pod`), so a
    re-run of the same issue/round must replace it wholesale rather than leave a stale phase from
    an earlier attempt behind. The clobber this issue is about is BETWEEN groups, and this group
    is ours.
    """
    if not phases:
        return  # an empty group is worse than none: it answers the alert's freshness clause
    url = os.environ.get("AGENT_PUSHGATEWAY_URL", PUSHGATEWAY_DEFAULT)
    if not url:
        return
    group = phase_group_path(stats.get("project"), _issue_segment(),
                             os.environ.get("AGENT_ROUND") or "1")
    try:
        req = urllib.request.Request(
            url.rstrip("/") + group, data=phase_metrics_body(phases).encode(), method="PUT",
            headers={"Content-Type": "text/plain"},
        )
        urllib.request.urlopen(req, timeout=10)
        print("phase-metrics: pushed %s → %s%s"
              % (",".join(phases), url.rstrip("/"), group), flush=True)
    except Exception as e:
        print("phase-metrics: pushgateway push FAILED: %s (non-fatal)" % e, file=sys.stderr)


def push_metrics(stats, exit_status, error_class):
    """Push this run's cost/duration/outcome to the Prometheus pushgateway (FU-057 §B1) so worker
    $ reaches Prometheus — today it only rode the Loki stats line. Coordinator/reviewer cost already
    lands via A0's OTLP `claude_code_*`; this is the goose-worker equivalent (goose has no OTLP).

    Grouping key = job/role/project/issue/round (PUT replaces that group, so a re-run of the same
    issue/round overwrites rather than accumulating a stale series). model/node/harness/exit_status/
    error_class ride as metric labels → the model-health & cost dashboards pivot on them. Best-effort:
    an unreachable pushgateway (or none) must never fail the run.
    """
    url = os.environ.get("AGENT_PUSHGATEWAY_URL", PUSHGATEWAY_DEFAULT)
    if not url:
        return
    issue = _issue_segment()
    rnd = os.environ.get("AGENT_ROUND") or "1"
    group = "/metrics/job/agent_run/role/worker/project/%s/issue/%s/round/%s" % (
        _seg(stats.get("project")), _seg(issue), _seg(rnd),
    )
    labels = 'model="%s",node="%s",harness="%s",exit_status="%s",error_class="%s"' % (
        _lv(stats.get("model", "")), _lv(stats.get("node", "")), _lv(stats.get("harness", "")),
        _lv(exit_status), _lv(error_class),
    )
    # cost is pushed ONLY when known — pushing 0 for an unreadable key re-creates the undercount
    # agent-runtime#12 fixed (the ledger-reflex backfills unknowns from the activity API).
    cost_line = ""
    if "cost_usd" in stats:
        cost_line = "# TYPE agent_run_cost_usd gauge\nagent_run_cost_usd{%s} %s\n" % (
            labels, stats["cost_usd"])
    # Subscription (claude) runs have no cost_usd — their usage record is tokens/turns (+ the
    # API-equivalent cost when the run emitted one). Push whichever exist so the model-health
    # and cost dashboards see the claude tier at all (homelab FU-066b).
    for key, metric in (("turns", "agent_run_turns"), ("tokens_in", "agent_run_tokens_in"),
                        ("tokens_out", "agent_run_tokens_out"),
                        ("cost_usd_equiv", "agent_run_cost_usd_equiv")):
        if key in stats:
            cost_line += "# TYPE %s gauge\n%s{%s} %s\n" % (metric, metric, labels, stats[key])
    body = (
        "%s"
        "# TYPE agent_run_duration_s gauge\n"
        'agent_run_duration_s{%s} %s\n'
        "# TYPE agent_run_total gauge\n"
        'agent_run_total{%s} 1\n'
    ) % (cost_line, labels, stats.get("duration_s", 0), labels)
    try:
        req = urllib.request.Request(
            url.rstrip("/") + group, data=body.encode(), method="PUT",
            headers={"Content-Type": "text/plain"},
        )
        urllib.request.urlopen(req, timeout=10)
        print("metrics: pushed → %s%s" % (url.rstrip("/"), group), flush=True)
    except Exception as e:
        print("metrics: pushgateway push FAILED: %s (non-fatal)" % e, file=sys.stderr)


def upload_transcripts(stats, log_path):
    """Persist the run's exhaust to the agent-transcripts bucket (homelab
    docs/agents/observability-and-retro.md §A1): manifest.json + run.log + the goose session dir →
    s3://<bucket>/<project>/<task>/worker-r<round>-<ts>/. The launcher (agents/agent-session.sh)
    injects the WRITE-ONLY key + task/round as env. Loud on failure, but NEVER fails the run —
    and it runs AFTER the AGENT_RUN_STATS line, so a hung/failed upload can't cost us the stats.
    """
    import shutil
    import subprocess
    import tempfile

    key_id = os.environ.get("AGENT_TS_ACCESS_KEY_ID")
    if not key_id:
        print("transcripts: no S3 key (AGENT_TS_* env absent) — upload skipped", file=sys.stderr)
        return
    s5 = shutil.which("s5cmd")
    if not s5:
        print("transcripts: s5cmd not in image — upload skipped", file=sys.stderr)
        return

    ts = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    task = os.environ.get("AGENT_TASK") or "adhoc"
    rnd = os.environ.get("AGENT_ROUND") or "1"
    bucket = os.environ.get("AGENT_TS_BUCKET", "agent-transcripts")
    endpoint = os.environ.get("AGENT_TS_ENDPOINT", "http://garage.garage.svc.cluster.local:3900")
    prefix = "s3://%s/%s/%s/worker-r%s-%s" % (bucket, stats.get("project") or "unknown", task, rnd, ts)
    env = dict(
        os.environ,
        AWS_ACCESS_KEY_ID=key_id,
        AWS_SECRET_ACCESS_KEY=os.environ.get("AGENT_TS_SECRET_ACCESS_KEY", ""),
        AWS_REGION="garage",
    )

    def put(src, dst):
        try:
            subprocess.run(
                [s5, "--endpoint-url", endpoint, "cp", src, dst],
                env=env, check=True, timeout=120,
                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            )
            return True
        except Exception as e:
            print("transcripts: upload FAILED for %s: %s (non-fatal)" % (src, e), file=sys.stderr)
            return False

    files = []
    if log_path and os.path.exists(log_path) and put(log_path, prefix + "/run.log"):
        files.append("run.log")
    # goose's native session files (the pod is fresh per run, so everything there is this run's).
    # opencode keeps no equivalent local transcript — run.log is its record.
    sdir = os.path.expanduser("~/.local/share/goose/sessions")
    for root, _, names in os.walk(sdir):
        for n in names:
            p = os.path.join(root, n)
            rel = os.path.relpath(p, sdir)
            if put(p, "%s/goose-sessions/%s" % (prefix, rel)):
                files.append("goose-sessions/" + rel)
    # claude's session jsonl (FU-066 claude harness — same fresh-pod argument). The transcripts-sync
    # treats any *.jsonl under the run prefix as a claude session, so these land viewer-ready.
    cdir = os.path.expanduser("~/.claude/projects")
    for root, _, names in os.walk(cdir):
        for n in names:
            if not n.endswith(".jsonl"):
                continue
            p = os.path.join(root, n)
            rel = os.path.relpath(p, cdir)
            if put(p, "%s/claude-sessions/%s" % (prefix, rel)):
                files.append("claude-sessions/" + rel)

    manifest = {
        "role": "worker",
        "project": stats.get("project", ""),
        # FU-061: carry {project, issue, role, round} so the viewer sync can group by issue and
        # rewrite each session's cwd. task stays "issue-<N>" (the bucket prefix); issue is the bare N.
        "issue": task[len("issue-"):] if task.startswith("issue-") else "",
        "task": task,
        "round": int(rnd) if rnd.isdigit() else rnd,
        "model": stats.get("model", ""),
        "harness": stats.get("harness", ""),
        "session_key": os.environ.get("AGENT_SESSION_KEY", ""),
        "stats": stats,
        "exit_status": stats.get("exit_status", ""),
        "error_class": stats.get("error_class", ""),
        "harness_exit": os.environ.get("HARNESS_EXIT", ""),
        "pr_url": stats.get("pr_url", ""),
        "pod": stats.get("pod", ""),
        "grafana_query": '{pod="%s"}' % stats.get("pod", ""),
        "files": files,
    }
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump(manifest, f, indent=1)
        mpath = f.name
    put(mpath, prefix + "/manifest.json")
    print("transcripts: uploaded → " + prefix, flush=True)


def finalize(log_path):
    # FIRST statement (#66): the in-pod boundary between the harness/LLM loop and this terminal
    # leg. Before the settle sleep below — those 6s are finalize's own, not the model's.
    finalize_epoch = time.time()
    time.sleep(6)  # let OpenRouter usage accounting settle for the last request(s)
    start_epoch = _read_float(START_EPOCH)
    stats = {
        "project": os.environ.get("PROJECT", ""),
        "pod": os.environ.get("HOSTNAME", ""),
        "node": os.environ.get("NODE_NAME", ""),
        "harness": os.environ.get("HARNESS", ""),
        "model": os.environ.get("GOOSE_MODEL") or os.environ.get("MODEL", ""),
        # KEY_HASH (operator-written into the session Secret) → the ledger-reflex can backfill a
        # cost_unknown run from the management API after the CR/pod are gone (FU-057 §ledger).
        "key_hash": os.environ.get("OPENROUTER_KEY_HASH", ""),
        "duration_s": max(0, int(time.time()) - int(start_epoch)) if start_epoch else 0,
    }
    # agent-runtime#81: fold AGENT_RAIL into the stats line so the run record carries which
    # billing rail served it. Absent env ⇒ omit the field (never default-guess a rail).
    rail = os.environ.get("AGENT_RAIL")
    if rail:
        stats["rail"] = rail
    # Retro r1 F6: split queue-wait from active run so ledger wall times stop conflating the two
    # (#8's "53.7h task" was days of queue). AGENT_DISPATCH_EPOCH is stamped by the launcher at
    # dispatch; queue_wait = dispatch → pod start, duration_s stays start → finalize.
    try:
        dispatch = int(float(os.environ.get("AGENT_DISPATCH_EPOCH", "") or 0))
    except ValueError:
        dispatch = 0
    if dispatch and start_epoch:
        stats["queue_wait_s"] = max(0, int(start_epoch) - dispatch)
    if stats.get("harness") == "claude":
        # Subscription tier (FU-066): no OpenRouter key in play, marginal cost ~$0 — the honest
        # record is tokens/turns (claude_usage), NOT cost_unknown (that flag means "backfill me
        # from the OpenRouter activity API", which can never apply here — no key_hash).
        stats["subscription"] = True
        stats.update(claude_usage())
        equiv = claude_cost_equiv(log_path) if log_path else None
        if equiv is not None:
            stats["cost_usd_equiv"] = round(equiv, 4)
    else:
        # Cost = usage delta, but ONLY when both ends read — see cost_fields (agent-runtime#12).
        stats.update(cost_fields(_read_float(USAGE_START), or_usage()))
    stats.update(parse_outcome(log_path) if log_path else {})
    # FU-064a: harness-owned terminal push BEFORE classification/bookkeeping, so the salvaged branch
    # rides the stats line and the strike comment. Also before derive_pr_url: a resumed branch can
    # carry an OLDER still-open PR, and a derived pr_url must never suppress the salvage of THIS
    # round's commits (review finding, #17).
    salvage_push(stats, log_path)
    # Ground-truth pr_url before classify/bookkeeping — both key off it (a missing pr_url on a
    # PR-ful run skipped arming and mis-routed the stats comment into a strike).
    derive_pr_url(stats)
    # FU-057: classify the run so the ledger/dashboards know *why* it ended (the model-blacklist
    # enabler). Fold exit_status+error_class into stats so they ride the AGENT_RUN_STATS line (→ the
    # launcher's PR comment + Loki) AND the manifest + pushed metrics below.
    exit_status, error_class = classify(log_path, stats)
    stats["exit_status"] = exit_status
    stats["error_class"] = error_class
    # FU-064/FU-043: in-pod GitHub bookkeeping BEFORE the stats line, so the *_by_pod flags it sets
    # ride the line and the launcher fallback knows what to skip.
    try:
        bookkeeping(stats, log_path)
    except Exception as e:
        print("bookkeeping: non-fatal error: %s" % e, file=sys.stderr)
    print("AGENT_RUN_STATS " + json.dumps(stats, separators=(",", ":")), flush=True)
    try:  # homelab FU-095 P1: the launcher's POST /report twin — coordinator-path rides have no
        # attending launcher, so without this their outcomes never reach the router's shadow
        # store. Idempotent per session server-side (INSERT OR REPLACE) — a double post from a
        # launcher-attended run is harmless by design.
        router_report(stats, exit_status, error_class)
    except Exception as e:
        print("router-report: non-fatal error: %s" % e, file=sys.stderr)
    try:  # FU-057 §B1: worker $ + outcome → Prometheus (goose has no OTLP rail)
        push_metrics(stats, exit_status, error_class)
    except Exception as e:
        print("metrics: non-fatal error: %s" % e, file=sys.stderr)
    try:  # FU-160 in-pod half (#66): the ride's interior, so the launcher's `ride` envelope stops
        # being one opaque bar. Pushed HERE and not after the transcript upload on purpose — the
        # `finalize` span would otherwise measure an S3 timeout, and the push would wait on it.
        push_phase_metrics(
            phase_durations(read_phase_marks(), start_epoch, finalize_epoch, time.time()), stats)
    except Exception as e:
        print("phase-metrics: non-fatal error: %s" % e, file=sys.stderr)
    try:  # §A1 capture — deliberately after the stats line
        upload_transcripts(stats, log_path)
    except Exception as e:
        print("transcripts: non-fatal error: %s" % e, file=sys.stderr)


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "--snapshot":
            snapshot()
        elif len(sys.argv) > 1 and sys.argv[1] == "--mark":
            # `agent-finalize --mark <phase> <seconds>` (#66). Missing args are refused by
            # mark_phase itself, loudly and with exit 0: a mis-called stats helper must not take
            # the ride down with it.
            mark_phase(sys.argv[2] if len(sys.argv) > 2 else "",
                       sys.argv[3] if len(sys.argv) > 3 else "")
        else:
            finalize(sys.argv[1] if len(sys.argv) > 1 else "")
    except Exception as e:  # never fail the run on stats
        print("agent-finalize: non-fatal error: %s" % e, file=sys.stderr)
